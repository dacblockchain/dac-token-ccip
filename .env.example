# RPC endpoints (optional — public fallbacks are used if unset)
MAINNET_RPC_URL=
BSC_RPC_URL=
SEPOLIA_RPC_URL=
BSC_TESTNET_RPC_URL=

# Deployer account private key (0x-prefixed). NEVER commit a real key.
# For scripts/03_claim_admin.js on Ethereum mainnet this must be the key of the
# DacToken owner (0x1A5C332B8aEEBA5489403A231d283dce59B00E11).
DEPLOYER_PRIVATE_KEY=

# Etherscan API key (v2 — also covers BscScan) for `npx hardhat verify`
ETHERSCAN_API_KEY=

# 01_deploy_token.js
TOKEN_ADMIN=      # burn/mint token admin on BSC (defaults to deployer)
TOKEN_RECIPIENT=  # testnet replica only
TOKEN_OWNER=      # testnet replica only

# 05_apply_chain_updates.js
RATE_LIMITS_ENABLED=true
RATE_LIMIT_CAPACITY=100000  # whole DACT
RATE_LIMIT_RATE=            # DACT per second (default: capacity/3600)

# 06_bridge_tokens.js
AMOUNT=
RECEIVER=
FEE_TOKEN=native  # native | link
